APP_NAME=GetL1
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=getl1
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Shared server: keep GetL1 in its own Redis DB and key prefix.
REDIS_DB=5
REDIS_CACHE_DB=6
REDIS_PREFIX=getl1_

# Hostinger mail: MAIL_MAILER=smtp, MAIL_SCHEME=smtps, MAIL_HOST=smtp.hostinger.com, MAIL_PORT=465
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@getl1.com"
MAIL_FROM_NAME="GetL1"
# Staging: only these addresses/domains get email (comma-separated). Empty = anyone.
MAIL_ALLOWLIST=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Live auctions (Laravel Reverb). Leave BROADCAST_CONNECTION=log to run with polling only.
# Reverb listens on localhost; nginx proxies wss://<host>/app to it.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=staging.getl1.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8090
REVERB_INTERNAL_HOST=127.0.0.1
REVERB_ALLOWED_ORIGINS=staging.getl1.com
REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Browser push (device alerts). Create on the server with: php artisan getl1:webpush-keys
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:support@getl1.com

# Staging only: shorter quote window for quick tests (production always uses at least 60).
RFQ_MIN_QUOTE_MINUTES=60
AUCTION_MIN_DURATION=10

# Razorpay (Dashboard → Account & Settings → API keys / Webhooks). Test keys start with rzp_test_.
# Webhook URL: https://<your host>/webhooks/razorpay
# Events: payment.captured, payment.failed, subscription.activated, subscription.charged,
#         subscription.pending, subscription.halted, subscription.cancelled, subscription.completed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GetL1's own receipts and invoices. Manage GST, GSTIN and billing details in Admin → Billing & GST;
# these are only starting defaults (empty name/address/email use the website's legal name, address and email).
BILLING_GST_ENABLED=false
BILLING_SELLER_STATE_CODE=06

# AI: reading requirements into RFQs (console.anthropic.com → API keys). Key only here, never in code or chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
